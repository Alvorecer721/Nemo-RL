# Adding to .gitignore helps reduce the size of your working_dir

/.git
*.out
*.log
*.tar
*.tar.gz
.venv
.venv-test
venv
venvs
__pycache__/
_build/
build/
apidocs/
dist/
*.egg-info/
*.vscode/
release_run*
ckpts/
mlruns/

# Test
coverage.json
.coverage*
test_assets/
actual_test_nemo_gym_sanity.json
.nrl_remote_map.json
.nrl_remote_state.json
