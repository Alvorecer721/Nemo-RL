# syntax=docker/dockerfile:1
# Thin Megatron overlay for the NGC NeMo-RL v0.6.0 image.
#
# The published nvcr.io/nvidia/nemo-rl:v0.6.0 image contains the NeMo-RL source
# and base venv, but the Megatron path is not import-complete for an external
# Megatron-Bridge checkout: Transformer Engine and ModelOpt are missing. This
# image installs the release image's own locked mcore/modelopt extras into the
# existing /opt/nemo_rl_venv. It is a dependency image, not a code fork.

FROM nvcr.io/nvidia/nemo-rl:v0.6.0

USER root
WORKDIR /opt/nemo-rl

ENV UV_PROJECT_ENVIRONMENT=/opt/nemo_rl_venv
ENV UV_LINK_MODE=copy
ENV PATH="/opt/nemo_rl_venv/bin:${PATH}"
ENV CUDA_HOME=/usr/local/cuda
ENV TORCH_CUDA_ARCH_LIST="9.0 10.0"
# Keep TE builds conservative on login/build nodes with many visible CPUs.
ARG MAX_JOBS=8
ARG NVTE_BUILD_THREADS_PER_JOB=1
ENV MAX_JOBS=${MAX_JOBS}
ENV NVTE_BUILD_THREADS_PER_JOB=${NVTE_BUILD_THREADS_PER_JOB}

# Tokenizer cold-load fix: tokenizers 0.22.1 (as shipped) loads our 135k-added-
# token tokenizer in 204s; 0.22.2 (hf tokenizers#1635, fixed by #1891) in 3.3s,
# byte-identical tokenization. Within transformers 5.3.0's pin. Lock-level so
# `uv run --locked` cannot revert it. Drop when the upstream lock reaches >=0.22.2.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv lock --upgrade-package tokenizers==0.22.2

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --inexact --extra mcore --extra modelopt --no-install-project

# Match the NeMo-RL Dockerfile convention: prefer pip-installed cuDNN when TE is
# imported, rather than the system cuDNN that may be a different patch version.
ENV CUDNN_HOME=/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn
ENV LD_LIBRARY_PATH="/opt/nemo_rl_venv/lib/python3.13/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"

# Fused CUDA xIELU for Apertus (3rdparty/kernels submodule — fork of
# nathanrchn/kernels with contiguity fix; init submodules before building).
# Optional at runtime — the bridge's XIELU module falls back to eager and warns.
COPY 3rdparty/kernels/xielu /opt/xielu-src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-build-isolation /opt/xielu-src

# Backport: raw Megatron checkpoint loading (upstream d9efd04, post-v0.6.0).
# One auditable patch onto the image's own NeMo-RL; delete at the next bump.
COPY docker/patches/0001-pretrained-checkpoint-backport.patch /tmp/mlm-restore.patch
RUN cd /opt/nemo-rl && git apply --check /tmp/mlm-restore.patch     && git apply /tmp/mlm-restore.patch && rm /tmp/mlm-restore.patch

# We changed deps (tokenizers re-lock) and code (patch) relative to the base
# image, so regenerate the container fingerprint — otherwise NeMo-RL's
# startup mismatch check would warn forever about a perfectly consistent image.
RUN cd /opt/nemo-rl && python tools/generate_fingerprint.py > /opt/nemo_rl_container_fingerprint

RUN python -c "import transformer_engine.pytorch as te; import modelopt; from modelopt.torch.opt.plugins import restore_modelopt_state; import xielu, torch; assert hasattr(torch.ops.xielu, 'xielu'); print('TE', te.__file__); print('ModelOpt', modelopt.__file__); print('xielu CUDA', xielu.__file__); import nemo_rl.utils.checkpoint as c; assert hasattr(c.CheckpointManager, 'get_resume_paths'), 'backport missing'; import tokenizers; assert tokenizers.__version__ >= '0.22.2', f'slow tokenizer load: {tokenizers.__version__}'"
