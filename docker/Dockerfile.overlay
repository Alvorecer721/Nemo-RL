# syntax=docker/dockerfile:1.7
# Incremental image on top of a published release: replace the project
# metadata and source, re-sync the baked environments against the new lock,
# and restamp the container fingerprint. The build context is the tracked
# source tree without 3rdparty/, which the base image already carries.
ARG BASE_RELEASE_IMAGE
FROM ${BASE_RELEASE_IMAGE}

ARG NEMO_RL_COMMIT
ARG NEMO_RL_BUILD_INPUTS_SHA256
ARG NEMO_RL_BUILD_FINGERPRINT_B64
ARG OVERLAY_NEGATIVE_FILTERS="trtllm dynamo nemo_gym"
ARG OVERLAY_GATE_VENVS="nemo_rl.models.policy.workers.megatron_policy_worker.MegatronPolicyWorker nemo_rl.models.generation.vllm.vllm_worker.VllmGenerationWorker nemo_rl.models.generation.vllm.vllm_worker_async.VllmAsyncGenerationWorker"

ENV NEMO_RL_COMMIT=${NEMO_RL_COMMIT:-<unknown>}
ENV NEMO_RL_BUILD_INPUTS_SHA256=${NEMO_RL_BUILD_INPUTS_SHA256:-<unknown>}
LABEL org.opencontainers.image.revision="${NEMO_RL_COMMIT}"
LABEL org.opencontainers.image.source-inputs="${NEMO_RL_BUILD_INPUTS_SHA256}"

WORKDIR /opt/nemo-rl
COPY . /opt/nemo-rl/

# Retain the base image's submodule pins: 3rdparty/ is inherited, not copied.
# Validate before restamping the changed lock and before anything imports nemo_rl.
RUN python tools/restamp_overlay_fingerprint.py \
    /opt/nemo_rl_container_fingerprint \
    /opt/nemo-rl/.nemo_rl_source_fingerprint.json

RUN UV_LINK_MODE=symlink bash tools/uv-sync-retry.sh --frozen --all-groups --no-install-project

RUN UV_LINK_MODE=symlink uv run --no-sync python -m nemo_rl.utils.prefetch_venvs \
    --negative-filters ${OVERLAY_NEGATIVE_FILTERS}

RUN <<"EOF" bash -exu -o pipefail
for venv in ${OVERLAY_GATE_VENVS}; do
    "/opt/ray_venvs/${venv}/bin/python" tools/check_nccl_m2n.py
done
EOF
